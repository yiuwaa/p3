<!DOCTYPE html>
<html lang="zh-Hant-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>長方形尋親記 — 互動故事書</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
:root {
  --ink: #2b2b2b;
  --pink: #ff7f50;
  --blue: #4fa3ff;
  --purple: #9b6bff;
  --yellow: #ffd93d;
  --green: #6bd66b;
  --paper: #fffdf7;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: "Noto Sans TC", "PingFangTC", "Microsoft JhengHei", sans-serif;
  color: var(--ink);
  background: linear-gradient(180deg, #cde8ff 0%, #eef7ff 45%, #d1f4e0 100%);
  min-height: 100vh;
}
#app {
  max-width: 960px;
  margin: 0 auto;
  padding: 14px;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
header h1 { font-size: 1.35rem; margin: 0; color: #1e3a8a; font-weight: 800; }
.tools { display: flex; gap: 8px; align-items: center; }
.tools button {
  border: none;
  background: #fff;
  border-radius: 999px;
  padding: 8px 16px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0,0,0,.12);
  transition: transform 0.15s, background-color 0.15s;
}
.tools button:hover { transform: translateY(-2px); background-color: #e0f2fe; }

.progress { display: flex; gap: 6px; flex-wrap: wrap; }
.progress span {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #fff;
  border: 2px solid #2563eb;
  display: inline-block;
  transition: 0.3s;
}
.progress span.done { background: #2563eb; }
.progress span.cur { background: #ffd93d; border-color: #d97706; transform: scale(1.3); }

.book {
  background: var(--paper);
  border-radius: 26px;
  padding: 22px;
  box-shadow: 0 10px 30px rgba(30,58,138,.18);
  border: 6px solid #fff;
  animation: pop 0.4s ease;
}
@keyframes pop {
  from { opacity: 0; transform: translateY(14px) scale(0.98); }
  to { opacity: 1; transform: none; }
}

.pagetitle {
  font-size: 1.5rem;
  margin: 0 0 12px;
  color: #1e3a8a;
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 800;
}
.scene {
  border-radius: 20px;
  padding: 18px 14px 8px;
  margin: 12px 0;
  position: relative;
  overflow: visible;
}
.village { background: linear-gradient(180deg, #dff3ff 0%, #dff3ff 65%, #b8e6a3 65%); }
.road    { background: linear-gradient(180deg, #e6f6ff 0%, #e6f6ff 60%, #e8d3a5 60%); }
.valley  { background: linear-gradient(180deg, #fff2d8 0%, #fff2d8 60%, #c9e2ff 60%); }
.hill    { background: linear-gradient(180deg, #ffe9f2 0%, #ffe9f2 60%, #b5d99c 60%); }
.home    { background: linear-gradient(180deg, #fff6d5 0%, #fff6d5 62%, #f5c9a0 62%); }

.stage {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 24px;
  flex-wrap: wrap;
  min-height: 200px;
}
.chara { margin: 0; text-align: center; animation: float 3s ease-in-out infinite; }
.chara:nth-child(2) { animation-delay: 0.6s; }
.chara:nth-child(3) { animation-delay: 1.2s; }
.chara svg { overflow: visible; filter: drop-shadow(0 6px 4px rgba(0,0,0,.18)); }
.chara figcaption {
  font-weight: 700;
  margin-top: 6px;
  background: #fff;
  border-radius: 999px;
  padding: 4px 14px;
  display: inline-block;
  box-shadow: 0 2px 5px rgba(0,0,0,.1);
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
.wiggle { animation: wiggle 0.7s ease-in-out infinite !important; }
@keyframes wiggle {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

.bubble {
  background: #fff;
  border: 3px solid var(--ink);
  border-radius: 18px;
  padding: 12px 16px;
  position: relative;
  margin: 12px 0;
  font-size: 1.1rem;
  line-height: 1.65;
}
.bubble::after {
  content: "";
  position: absolute;
  left: 34px;
  bottom: -16px;
  border: 9px solid transparent;
  border-top-color: var(--ink);
}
.bubble b { color: #1d6fd6; }
.narr { font-size: 1.15rem; line-height: 1.8; margin: 10px 0; }
.letter {
  background: #f0f9ff;
  border: 2px dashed #0284c7;
  border-radius: 14px;
  padding: 16px 20px;
  font-size: 1.1rem;
  line-height: 1.8;
  transform: rotate(-1deg);
  box-shadow: 3px 4px 0 #bae6fd;
}
.card-checklist {
  list-style: none;
  padding: 0;
  margin: 10px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.card-checklist li {
  padding: 6px 14px;
  border-radius: 999px;
  font-weight: 700;
  background: #fff;
  border: 2px solid #ccc;
}
.card-checklist li.y { border-color: #2e9e4f; color: #1f7a3a; background: #e9f9ee; }
.card-checklist li.n { border-color: #d33; color: #b22; background: #fdeaea; }

.feat-btns { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin: 12px 0; }
.feat-btns button, .btn {
  font-size: 1.05rem;
  padding: 10px 18px;
  border-radius: 14px;
  border: 3px solid #1e3a8a;
  background: #fff;
  cursor: pointer;
  transition: 0.15s;
  font-family: inherit;
  font-weight: 700;
  min-height: 48px;
}
.feat-btns button:hover, .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,.15); }
.feat-btns button.on { background: #bae6fd; border-color: #0284c7; }

.quiz-card {
  background: #e0f2fe;
  border-radius: 18px;
  padding: 16px;
  margin: 14px 0;
  border: 3px solid #7dd3fc;
}
.quiz-card h3 { margin: 0 0 10px; font-size: 1.15rem; color: #1e3a8a; font-weight: 800; }
.choices-container { display: flex; flex-direction: column; gap: 10px; margin: 10px 0; }
.choice-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: 16px;
  border: 3px solid #1e3a8a;
  background: #fff;
  cursor: pointer;
  transition: 0.15s;
  text-align: left;
  font-size: 1.05rem;
  font-weight: 600;
  min-height: 52px;
}
.choice-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,.1); }
.choice-btn.sel-correct { background: #d9f7e1; border-color: #2e9e4f; }
.choice-btn.sel-wrong { background: #fde2e2; border-color: #d33; opacity: 0.75; }

.badge-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  font-size: 1.25rem;
  font-weight: 900;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 2px 5px rgba(0,0,0,0.15);
}
.badge-A { background: #e63946; }
.badge-B { background: #1d6fd6; }
.badge-C { background: #d97706; }
.badge-D { background: #059669; }

.fb { display: none; padding: 12px 16px; border-radius: 12px; margin-top: 10px; font-size: 1.05rem; line-height: 1.6; }
.fb.show { display: block; animation: pop 0.3s; }
.fb.ok { background: #e0f7e6; border: 2px solid #2e9e4f; }
.fb.no { background: #fff1d6; border: 2px solid #e6a800; }

.nest { border-radius: 26px; padding: 16px; margin: 10px auto; position: relative; text-align: center; animation: pop 0.5s both; }
.nest .lbl { font-weight: 800; font-size: 1.05rem; display: block; margin-bottom: 6px; }
.nest small { display: block; font-weight: 500; font-size: 0.9rem; color: #374151; margin-top: 2px; }
.n1 { background: #e9ddff; border: 3px solid #9b6bff; max-width: 580px; }
.n2 { background: #d7e9ff; border: 3px solid #4fa3ff; max-width: 450px; }
.n3 { background: #ffdccc; border: 3px solid #ff7f50; max-width: 320px; }

.rule { background: #fff; border-left: 8px solid #2563eb; padding: 12px 16px; border-radius: 10px; margin: 10px 0; font-size: 1.1rem; line-height: 1.7; }
.rule.warn { border-color: #e6a800; background: #fff8e1; }
.path { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
.path button { flex: 1; min-width: 220px; padding: 18px; font-size: 1.15rem; border-radius: 18px; }

.next-btn {
  display: block;
  margin: 18px auto 0;
  background: #ffd93d;
  border-color: #e6a800;
  font-size: 1.2rem;
  padding: 12px 36px;
  font-weight: 800;
}
.hidden { display: none !important; }
.score { font-weight: 800; color: #1e3a8a; font-size: 1.4rem; }
.confetti { position: fixed; top: -20px; width: 10px; height: 16px; border-radius: 2px; animation: fall linear forwards; z-index: 99; pointer-events: none; }
@keyframes fall { to { transform: translateY(110vh) rotate(720deg); } }
</style>
</head>
<body>

<div id="app">
  <header>
    <h1>📘 長方形尋親記</h1>
    <div class="progress" id="prog"></div>
    <div class="tools">
      <button id="readBtn" title="朗讀本頁">🔊 朗讀</button>
      <button id="homeBtn" title="返回封面">🏠 封面</button>
    </div>
  </header>

  <main class="book" id="page"></main>

  <footer class="text-center text-xs text-gray-600 mt-4">
    香港小三數學・四邊形包含關係（平行四邊形、長方形、正方形）互動故事書
  </footer>
</div>

<script>
/* ==========================================
   SVG 圖形與角色渲染器
   ========================================== */
const SHAPES = {
  rect:   { pts: [[5,42],[145,42],[145,118],[5,118]], color: '#4fa3ff' }, // 方方（長方形）
  square: { pts: [[25,25],[125,25],[125,125],[25,125]], color: '#ff7f50' }, // 小正（正方形）
  rect2:  { pts: [[40,15],[110,15],[110,130],[40,130]], color: '#6ec1ff' },
  para:   { pts: [[45,35],[150,35],[105,125],[0,125]], color: '#9b6bff' }, // 阿平爺爺
  tri:    { pts: [[75,18],[142,130],[8,130]], color: '#ffd93d' }, 
  quad:   { pts: [[20,45],[130,20],[118,125],[45,105]], color: '#6bd66b' } 
};

function shapeSVG(key, o = {}) {
  const s = SHAPES[key] || SHAPES.rect;
  const pts = s.pts;
  const n = pts.length;
  const size = o.size || 150;
  const cx = pts.reduce((a, p) => a + p[0], 0) / n;
  const cy = pts.reduce((a, p) => a + p[1], 0) / n;
  const side = i => [pts[i], pts[(i + 1) % n]];
  let g = '';

  // 延長對邊虛線
  if (o.ext) {
    const f = o.ext === true ? 0.45 : o.ext;
    for (let i = 0; i < n; i++) {
      const [a, b] = side(i);
      const dx = b[0] - a[0], dy = b[1] - a[1];
      const col = i % 2 ? '#1d6fd6' : '#e63946';
      g += `<line x1="${a[0] - dx * f}" y1="${a[1] - dy * f}" x2="${b[0] + dx * f}" y2="${b[1] + dy * f}" stroke="${col}" stroke-width="2.5" stroke-dasharray="6 4" opacity=".8"/>`;
    }
  }

  // 本體多邊形
  g += `<polygon points="${pts.map(p => p.join(',')).join(' ')}" fill="${s.color}" stroke="#2b2b2b" stroke-width="3" stroke-linejoin="round"/>`;

  // 平行對邊粗線
  if (o.parallel) {
    for (let i = 0; i < n; i++) {
      const [a, b] = side(i);
      const col = i % 2 ? '#1d6fd6' : '#e63946';
      g += `<line x1="${a[0]}" y1="${a[1]}" x2="${b[0]}" y2="${b[1]}" stroke="${col}" stroke-width="7" stroke-linecap="round"/>`;
    }
  }

  // 直角記號
  if (o.right) {
    for (let i = 0; i < n; i++) {
      const v = pts[i], p = pts[(i - 1 + n) % n], q = pts[(i + 1) % n];
      let u1 = [p[0] - v[0], p[1] - v[1]], u2 = [q[0] - v[0], q[1] - v[1]];
      const l1 = Math.hypot(...u1), l2 = Math.hypot(...u2);
      if (l1 && l2) {
        u1 = u1.map(x => x / l1); u2 = u2.map(x => x / l2);
        if (Math.abs(u1[0] * u2[0] + u1[1] * u2[1]) < 0.05) {
          const a = 15;
          const P = [
            [v[0] + u1[0] * a, v[1] + u1[1] * a],
            [v[0] + (u1[0] + u2[0]) * a, v[1] + (u1[1] + u2[1]) * a],
            [v[0] + u2[0] * a, v[1] + u2[1] * a]
          ];
          g += `<polyline points="${P.map(p => p.join(',')).join(' ')}" fill="none" stroke="#c1121f" stroke-width="3"/><circle cx="${P[1][0]}" cy="${P[1][1]}" r="2.2" fill="#c1121f"/>`;
        }
      }
    }
  }

  // 對邊長度相等記號（長方形：上下單線，左右雙線）
  if (o.equalOpp) {
    for (let i = 0; i < n; i++) {
      const [a, b] = side(i);
      const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy);
      if (L) {
        const nx = -dy / L * 8, ny = dx / L * 8;
        const tx = dx / L * 4, ty = dy / L * 4;
        const count = i % 2 === 0 ? 1 : 2;
        for (let k = 0; k < count; k++) {
          const offset = (k - (count - 1) / 2) * 2;
          const mx = a[0] + dx / 2 + tx * offset, my = a[1] + dy / 2 + ty * offset;
          g += `<line x1="${mx - nx}" y1="${my - ny}" x2="${mx + nx}" y2="${my + ny}" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round"/>`;
        }
      }
    }
  }

  // 四邊長度相等記號（正方形）
  if (o.equalAll) {
    for (let i = 0; i < n; i++) {
      const [a, b] = side(i);
      const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy);
      if (L) {
        const nx = -dy / L * 8, ny = dx / L * 8;
        const mx = a[0] + dx / 2, my = a[1] + dy / 2;
        g += `<line x1="${mx - nx}" y1="${my - ny}" x2="${mx + nx}" y2="${my + ny}" stroke="#2b2b2b" stroke-width="3.5" stroke-linecap="round"/>`;
      }
    }
  }

  if (o.rotate) {
    g = `<g transform="rotate(${o.rotate} ${cx} ${cy})">${g}</g>`;
  }

  // 面部五官
  const ey = cy - 6, ex = 14, mood = o.mood || 'happy';
  let face = `
    <circle cx="${cx - ex}" cy="${ey}" r="8" fill="#fff" stroke="#2b2b2b" stroke-width="2"/>
    <circle cx="${cx + ex}" cy="${ey}" r="8" fill="#fff" stroke="#2b2b2b" stroke-width="2"/>
    <circle cx="${cx - ex + 2}" cy="${ey + 1}" r="3.5" fill="#2b2b2b"/>
    <circle cx="${cx + ex + 2}" cy="${ey + 1}" r="3.5" fill="#2b2b2b"/>
    <circle cx="${cx - ex - 9}" cy="${cy + 9}" r="4" fill="#ff9aa2" opacity=".7"/>
    <circle cx="${cx + ex + 9}" cy="${cy + 9}" r="4" fill="#ff9aa2" opacity=".7"/>
  `;
  if (mood === 'happy') face += `<path d="M${cx - 11} ${cy + 10} Q${cx} ${cy + 24} ${cx + 11} ${cy + 10}" fill="none" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round"/>`;
  if (mood === 'sad')   face += `<path d="M${cx - 11} ${cy + 19} Q${cx} ${cy + 7} ${cx + 11} ${cy + 19}" fill="none" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round"/>`;
  if (mood === 'wow')   face += `<ellipse cx="${cx}" cy="${cy + 15}" rx="6" ry="7" fill="#2b2b2b"/>`;
  if (mood === 'think') face += `<path d="M${cx - 9} ${cy + 15} L${cx + 9} ${cy + 13}" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round"/>`;
  if (o.glasses)        face += `<circle cx="${cx - ex}" cy="${ey}" r="11.5" fill="none" stroke="#5a3e1b" stroke-width="2.5"/><circle cx="${cx + ex}" cy="${ey}" r="11.5" fill="none" stroke="#5a3e1b" stroke-width="2.5"/><line x1="${cx - ex + 11.5}" y1="${ey}" x2="${cx + ex - 11.5}" y2="${ey}" stroke="#5a3e1b" stroke-width="2.5"/>`;
  if (o.hair)           face += `<path d="M${cx - 4} ${pts[0][1]} q4 -18 12 -10" stroke="#2b2b2b" stroke-width="3" fill="none" stroke-linecap="round"/>`;
  if (o.tie)            face += `<path d="M${cx - 5} ${cy + 27} l5 5 l5 -5 l-5 -4z" fill="#c1121f"/>`;

  return `<svg viewBox="-12 -12 174 156" width="${size}" height="${size * 156 / 174}" xmlns="http://www.w3.org/2000/svg">${g}${face}</svg>`;
}

const chara = (key, o, label, cls = '') => `<figure class="chara ${cls}">${shapeSVG(key, o)}<figcaption>${label}</figcaption></figure>`;
const cardCheck = items => `<ul class="card-checklist">${items.map(i => `<li class="${i[0] ? 'y' : 'n'}">${i[0] ? '✔' : '✘'} ${i[1]}</li>`).join('')}</ul>`;
const nextBtn = (hidden = false, txt = '下一頁 ➜') => `<button class="btn next-btn ${hidden ? 'hidden' : ''}" id="nextBtn" data-next="1">${txt}</button>`;

/* ==========================================
   故事問題資料庫
   ========================================== */
const QUIZ = {
  q2: {
    q: '出門前，方方想帶一樣工具幫忙檢查親戚是否有「直角」與「對邊平行」。你會建議他帶什麼？',
    options: [
      { t: '📐 一把三角尺（可以檢查直角，也可以看對邊是否平行）', ok: true, fb: '太讚了！三角尺既能量直角，也能靠在邊上檢查平行。方方帶著三角尺出發了！' },
      { t: '⭕ 一隻圓規', ok: false, fb: '圓規是畫圓形的，沒辦法檢查直角和平行線喔！再想想。' },
      { t: '🎈 一個氣球', ok: false, fb: '氣球很可愛，但幫不上忙呢！再試一次。' }
    ]
  },
  q3: {
    q: '方方發現小正有長方形的所有特徵（4條邊、對邊平行、4個直角）。那麼，小正也是長方形嗎？',
    options: [
      { t: '是！正方形具備長方形的所有特徵，所以所有正方形都是特別的「四條邊長度相等的長方形」。', ok: true, fb: '答對了！只要符合長方形的全部條件，就是長方形。小正只是四條邊都一樣長而已！' },
      { t: '不是，正方形是正方形，長方形是長方形，兩者完全無關。', ok: false, fb: '再想想看：長方形的三個條件（4條邊、對邊平行、4個直角），小正是不是全部都符合呢？' }
    ]
  },
  q4: {
    q: '歪歪有 4 條邊，他是平行四邊形家族的成員嗎？',
    options: [
      { t: '是，因為他有 4 條邊。', ok: false, fb: '有 4 條邊只是第一個條件！爺爺信中說還要「兩組對邊分別平行」。點選上面的「延長對邊觀察」看看！' },
      { t: '不是，因為他的對邊延長後會碰在一起，沒有兩組對邊平行。', ok: true, fb: '太棒了！歪歪只是普通四邊形，因為他的對邊延長後相交了，不符合平行條件。' }
    ]
  },
  q6a: {
    q: '直角谷裏這些長方形的門窗，是平行四邊形家族的成員嗎？',
    options: [
      { t: '是！它們有 4 條邊，而且兩組對邊分別平行。', ok: true, fb: '答對了！有直角的長方形，對邊一樣互相平行，所以也是平行四邊形家族的一員。' },
      { t: '不是，因為它們有直角，太齊整了。', ok: false, fb: '有直角不會讓它「不是」平行四邊形啊！只要對邊平行，就是家族成員。' }
    ]
  },
  q6b: {
    q: '斜坡山路上的房子斜斜的，它們有 4 個直角嗎？',
    options: [
      { t: '沒有。它們的角是斜的（沒有直角），但兩組對邊仍然平行。', ok: true, fb: '觀察得非常仔細！沒有直角，但對邊平行——這正是平行四邊形最基本的樣子。' },
      { t: '有，所有房子都有直角。', ok: false, fb: '用三角尺量量看：斜斜的角不是 90 度的直角呢！' }
