function quizHTML(id, reveal = '') {
  const BADGES = ['A', 'B', 'C', 'D'];
  const q = QUIZ[id];
  return `
    <div class="quiz-card" data-q="${id}" data-reveal="${reveal}">
      <h3>🤔 ${q.q}</h3>
      <div class="choices-container">
        ${q.options.map((o, i) => `
          <button class="choice-btn" data-opt="${i}">
            <span class="badge-box badge-${BADGES[i]}">${BADGES[i]}</span>
            <span class="choice-text">${o.t}</span>
          </button>
        `).join('')}
      </div>
      <div class="fb"></div>
    </div>
  `;
}

