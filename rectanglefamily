   ========================================== */
function goToPage(n) {
  state.page = Math.max(0, Math.min(pages.length - 1, n));
  const p = pages[state.page];
  const pageEl = document.getElementById('page');
  if (!pageEl) return;

  pageEl.innerHTML = typeof p.render === 'function' ? p.render() : p.render;
  pageEl.style.animation = 'none';
  pageEl.offsetHeight; // 強制重繪觸發 CSS 動畫
  pageEl.style.animation = '';

  if (p.after) p.after();

  const prog = document.getElementById('prog');
  if (prog) {
    prog.innerHTML = pages.map((_, i) => 
      `<span class="${i < state.page ? 'done' : i === state.page ? 'cur' : ''}"></span>`
    ).join('');
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if ('speechSynthesis' in window) speechSynthesis.cancel();
}

function renderHeroFeature() {
  const f = state.seen;
  const heroEl = document.getElementById('heroShape');
  if (heroEl) {
    heroEl.innerHTML = chara('rect', {
      tie: true,
      size: 210,
      parallel: f.has('parallel'),
      right: f.has('right'),
      equalOpp: f.has('equalOpp')
    }, '方方（長方形）');
  }
}

function renderSortItem() {
  const box = document.getElementById('sortBox');
  if (!box) return;

  if (state.sortIdx >= SORT_ITEMS.length) {
    box.innerHTML = `
      <div class="text-center p-4">
        <p class="narr">🎉 分類挑戰完成！你答對了 <span class="score">${state.sortScore} / ${SORT_ITEMS.length}</span> 題。</p>
        <div class="stage flex justify-center mt-4">${chara('rect', { tie: true, mood: 'happy' }, '方方：「你太棒了！」')}</div>
      </div>
    `;
    const nextBtnEl = document.getElementById('nextBtn');
    if (nextBtnEl) nextBtnEl.classList.remove('hidden');
    return;
  }

  const it = SORT_ITEMS[state.sortIdx];
  state.sortLocked = false;

  box.innerHTML = `
    <div class="sort-container text-center">
      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <span class="font-bold text-blue-900">第 ${state.sortIdx + 1} / ${SORT_ITEMS.length} 位鄰居 — 他是……？</span>
        <button class="btn" data-action="hint" style="padding:4px 12px; font-size:0.9rem">🔍 顯示特徵記號</button>
      </div>
      <div class="stage flex justify-center py-4" id="sortStage">${chara(it.key, { ...it.o, size: 160 }, '？')}</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
        ${SORT_LABELS.map((l, i) => `
          <button class="choice-btn" data-sort-opt="${i}">
            <span class="badge-box badge-${['A','B','C','D'][i]}">${['A','B','C','D'][i]}</span>
            <span class="choice-text text-left">${l}</span>
          </button>
        `).join('')}
      </div>
      <div class="fb"></div>
    </div>
  `;
}

function playSound(ok = true) {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.type = 'sine';
    osc.frequency.setValueAtTime(ok ? 660 : 300, ctx.currentTime);
    if (ok) osc.frequency.setValueAtTime(990, ctx.currentTime + 0.12);
    gain.gain.setValueAtTime(0.2, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
    osc.start();
    osc.stop(ctx.currentTime + 0.4);
  } catch (e) {}
}

function confetti() {
  const cols = ['#4fa3ff', '#ff7f50', '#9b6bff', '#ffd93d', '#6bd66b', '#ff9aa2'];
  for (let i = 0; i < 70; i++) {
    const d = document.createElement('div');
    d.className = 'confetti';
    d.style.left = Math.random() * 100 + 'vw';
    d.style.background = cols[i % cols.length];
    d.style.animationDuration = (2.5 + Math.random() * 2.5) + 's';
    d.style.animationDelay = (Math.random() * 1.5) + 's';
    d.style.transform = `rotate(${Math.random() * 360}deg)`;
    document.body.appendChild(d);
    setTimeout(() => d.remove(), 6000);
  }
}

/* ==========================================
   事件監聽與初始化
   ========================================== */
document.addEventListener('DOMContentLoaded', () => {
  const appEl = document.getElementById('app');

  appEl.addEventListener('click', e => {
    const t = e.target.closest('button');
    if (!t) return;

    if (t.dataset.next) { goToPage(state.page + 1); return; }
    if (t.dataset.goto !== undefined) { goToPage(+t.dataset.goto); return; }
    if (t.dataset.path) { state.path = t.dataset.path; playSound(true); goToPage(state.page + 1); return; }

    if (t.dataset.feature) {
      const f = t.dataset.feature;
      state.seen.add(f);
      t.classList.add('on');
      renderHeroFeature();
      const featText = document.getElementById('featText');
      if (featText) featText.innerHTML = FEAT_DESC[f];
      if (state.seen.size === 3) {
        const nextBtnEl = document.getElementById('nextBtn');
        if (nextBtnEl) nextBtnEl.classList.remove('hidden');
        const featHint = document.getElementById('featHint');
        if (featHint) featHint.textContent = '三個特徵都探究過囉，做得好！👍';
        playSound(true);
      }
      return;
    }

    if (t.dataset.toggleExt) {
      state.ext = !state.ext;
      t.classList.toggle('on', state.ext);
      const quadStage = document.getElementById('quadStage');
      if (quadStage) {
        quadStage.innerHTML = 
          chara('rect', { tie: true, mood: 'think' }, '方方') +
          chara('tri', { mood: 'happy', size: 120 }, '阿三（3條邊）') +
          chara('quad', { mood: state.ext ? 'sad' : 'happy', ext: state.ext ? 0.8 : false, size: 170 }, '歪歪（4條邊）');
      }
      const extText = document.getElementById('extText');
      if (extText) extText.classList.toggle('hidden', !state.ext);
      return;
    }

    if (t.dataset.action === 'hint') {
      const it = SORT_ITEMS[state.sortIdx];
      const sortStage = document.getElementById('sortStage');
      if (sortStage) {
        sortStage.innerHTML = chara(it.key, {
          ...it.o,
          size: 160,
          parallel: true,
          right: true,
          equalAll: it.key === 'square',
          equalOpp: it.key === 'rect' || it.key === 'rect2',
          ext: it.key === 'quad' ? 0.8 : false
        }, '？');
      }
      return;
    }

    if (t.dataset.sortOpt !== undefined) {
      if (state.sortLocked) return;
      const it = SORT_ITEMS[state.sortIdx];
      const i = +t.dataset.sortOpt;
      const fb = t.closest('.sort-container').querySelector('.fb');

      if (i === it.ans) {
        state.sortLocked = true;
        state.sortScore++;
        t.classList.add('sel-correct');
        fb.className = 'fb show ok';
        fb.innerHTML = '✅ ' + it.fb + ' <button class="btn" data-sortnext="1" style="margin-left:8px; padding:4px 12px; font-size:0.9rem;">下一位 ➜</button>';
        playSound(true);
      } else {
        t.classList.add('sel-wrong');
        t.disabled = true;
        fb.className = 'fb show no';
        fb.innerHTML = '💡 再想一想：先數邊數，再看對邊是否平行，然後檢查直角與四邊長度。';
        playSound(false);
      }
      return;
    }

    if (t.dataset.sortnext) {
      state.sortIdx++;
      renderSortItem();
      return;
    }

    if (t.dataset.opt !== undefined) {
      const qCard = t.closest('.quiz-card');
      if (qCard.classList.contains('done')) return;
      const q = QUIZ[qCard.dataset.q];
      const opt = q.options[+t.dataset.opt];
      const fb = qCard.querySelector('.fb');

      fb.innerHTML = (opt.ok ? '✅ ' : '💡 ') + opt.fb;
      fb.className = 'fb show ' + (opt.ok ? 'ok' : 'no');

      if (opt.ok) {
        qCard.classList.add('done');
        t.classList.add('sel-correct');
        qCard.querySelectorAll('.choice-btn').forEach(b => b.disabled = true);
        playSound(true);
        if (qCard.dataset.reveal) {
          qCard.dataset.reveal.split(',').forEach(sel => {
            document.querySelectorAll(sel.trim()).forEach(el => el.classList.remove('hidden'));
          });
        }
      } else {
        t.classList.add('sel-wrong');
        t.disabled = true;
        playSound(false);
      }
    }
  });

  // 工具列按鈕
  document.getElementById('homeBtn').onclick = () => goToPage(0);
  
  // 廣東話語音朗讀
  document.getElementById('readBtn').onclick = () => {
    if (!('speechSynthesis' in window)) return;
    speechSynthesis.cancel();
    const p = pages[state.page];
    const txt = typeof p.narr === 'function' ? p.narr() : p.narr;
    const u = new SpeechSynthesisUtterance(txt);
    u.lang = 'zh-HK';
    u.rate = 0.9;
    const voices = speechSynthesis.getVoices();
    const v = voices.find(v => v.lang.replace('_', '-') === 'zh-HK') || voices.find(v => v.lang.startsWith('zh'));
    if (v) u.voice = v;
    speechSynthesis.speak(u);
  };

  // 初始化前往封面頁
  goToPage(0);
});
</script>
